# =============================================================================
# Safe Route AI - environment template
#
# Copy to .env and fill in. .env is gitignored; this file is committed and must
# never contain a real value.
#
#   cp .env.example .env
#
# EXPO_PUBLIC_* is INLINED INTO THE APP BUNDLE at build time. Anyone with the
# .apk or the web build can read it. Treat every value here as public.
# Secrets live in Supabase Edge Function secrets - see the bottom of this file.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Project Settings -> API. The anon key is designed to be public: it is
# powerless on its own, because Row Level Security is what actually authorises
# every read and write. That is only true if RLS is enabled on every table.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# --- Backend switch ----------------------------------------------------------
# The app currently runs against the in-app mock backend. Flip to "supabase"
# once the schema and RLS policies are live.
EXPO_PUBLIC_API_MODE=mock


# --- Maps --------------------------------------------------------------------
# Android needs a Google Maps SDK key or the map renders as a blank grey grid.
# iOS uses Apple Maps and needs nothing. Restrict the key by package name and
# SHA-1 fingerprint in the Google Cloud console, or it will be scraped and used.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=


# --- Directions --------------------------------------------------------------
# Safe Route calls this for candidate routes. Currently synthesised from the
# corridors in constants/regions.ts, so this is only needed once routing goes
# live. This is the main per-request cost in the whole system - cache
# aggressively and prefer the server-side proxy below in production.
EXPO_PUBLIC_DIRECTIONS_PROVIDER=mapbox
EXPO_PUBLIC_MAPBOX_TOKEN=


# --- Diagnostics -------------------------------------------------------------
# Optional. Leave blank to disable crash reporting.
EXPO_PUBLIC_SENTRY_DSN=


# =============================================================================
# NEVER PUT THESE HERE
#
# These must be set as Supabase Edge Function secrets, not in this file and not
# with an EXPO_PUBLIC_ prefix. Anything in this file ships inside the app.
#
#   supabase secrets set XAI_API_KEY=...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set DIRECTIONS_API_KEY=...
#
#   XAI_API_KEY                 Grok. Classification runs server-side precisely
#                               so this key never reaches a device.
#   SUPABASE_SERVICE_ROLE_KEY   Bypasses RLS entirely. Server only, always.
#   EXPO_ACCESS_TOKEN           Push delivery from the alert fan-out function.
#   DIRECTIONS_API_KEY          Preferred over the public key above once routing
#                               is proxied through an Edge Function.
# =============================================================================
